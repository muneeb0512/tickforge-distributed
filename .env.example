# Copy this file to .env and fill in real values.
# .env is gitignored - never commit real credentials.
#
# Every block below is commented out because nothing in the codebase reads
# it yet. Uncommented as its milestone actually introduces the dependency,
# so this file always reflects what the running system truly needs.

# --- Market data provider (Milestone 1: Binance public trade stream) ---
# Binance's market-data WebSocket streams are public - no API key needed,
# unlike most equities providers (Finnhub, Alpaca, Polygon), which is one
# of the reasons this provider was chosen. See docs/milestone-1-ingestion.md.
TICKFORGE_SYMBOLS=btcusdt,ethusdt

# --- Kafka (introduced in Milestone 2) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis (introduced in Milestone 3) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- PostgreSQL (introduced in Milestone 4) ---
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=tickforge
# POSTGRES_USER=tickforge
# POSTGRES_PASSWORD=
